{
  "id": "Test-m6pakr",
  "name": "Sable",
  "version": "1.0.0",
  "manifestVersion": 5,
  "main": "index.html",
  "host": {
    "app": "PS",
    "minVersion": "23.0.0"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "mainPanel",
      "label": { "default": "Sable" },
      "minimumSize": { "width": 260, "height": 400 },
      "maximumSize": { "width": 800, "height": 1400 },
      "preferredDockedSize": { "width": 280, "height": 600 },
      "icons": [
        {
          "width": 32,
          "height": 32,
          "path": "images/icon@1x.png",
          "scale": [1, 2],
          "theme": ["dark", "darkest"],
          "species": ["generic"]
        },
        {
          "width": 32,
          "height": 32,
          "path": "images/icon@2x.png",
          "scale": [1, 2],
          "theme": ["lightest", "light"],
          "species": ["generic"]
        }
      ]
    }
  ],
  "icons": [
    {
      "width": 32,
      "height": 32,
      "path": "images/icon@1x.png",
      "scale": [1, 2],
      "theme": ["dark", "darkest"],
      "species": ["generic"]
    },
    {
      "width": 32,
      "height": 32,
      "path": "images/icon@2x.png",
      "scale": [1, 2],
      "theme": ["lightest", "light"],
      "species": ["generic"]
    }
  ],
  "requiredPermissions": {
    "network": {
      "domains": [
        "https://oryvn-backend-production.up.railway.app"
      ]
    },
    "launchProcess": {
      "schemes": ["https", "http"]
    },
    "allowCodeGenerationFromStrings": true
  }
}
